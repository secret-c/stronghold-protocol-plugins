{
  "name": "sp-mp",
  "displayName": "多人容量叠加层 · Multiplayer capacity overlay",
  "version": "1.6.1",
  "description": "Co-op rooms of 4 / 8 / 12 seats, damage statistics, room chat, and a shared-pool viewer with personal shop bond choices, loaded as an overlay without changing the original install.",
  "base": "0.2.6",
  "supports": [
    "0.2.6"
  ],
  "files": 52,
  "publicFiles": 20,
  "entry": "start.mjs",
  "hooks": "hooks.mjs",
  "rebase": "tools/rebase.mjs",
  "feature": {
    "roomCapacities": [
      4,
      8,
      12
    ],
    "defaultSeats": 4,
    "maxSeats": 12,
    "scaleLadder": {
      "1-4": 1,
      "5-8": 2,
      "9-12": 3
    },
    "unitePrefersHumans": true,
    "damagePanel": true,
    "clientPlugin": "sp-mp/client/entry.js",
    "latestMatchStatistics": true,
    "roomChat": true,
    "poolInspector": true,
    "personalShopAffinity": true
  },
  "clientFiles": 3,
  "docs": {
    "development": "DEVELOPMENT.md",
    "devlog": "docs/DEVLOG.md",
    "readme": "README.md"
  },
  "verify": "node sp-mp/tools/test-client.mjs"
}
